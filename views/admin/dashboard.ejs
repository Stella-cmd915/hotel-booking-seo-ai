<%- include('_top') %>
<h1>Πίνακας ελέγχου</h1>
<div class="kpis">
  <div class="kpi"><span>Ενεργές κρατήσεις</span><strong><%= k.n %></strong></div>
  <div class="kpi"><span>Έσοδα κρατήσεων</span><strong><%= Math.round(k.rev).toLocaleString('el-GR') %> €</strong></div>
  <div class="kpi"><span>Μέση τιμή δωματίου (ADR)</span><strong><%= adr %> €</strong></div>
  <div class="kpi"><span>Πληρότητα επόμενων 30 ημερών</span><strong><%= occupancy %>%</strong></div>
</div>
<div class="admin-grid">
  <section class="panel">
    <h2>Χωνί μετατροπής (άμεσο κανάλι)</h2>
    <% const max = Math.max(...funnel.map(f => f.n), 1); funnel.forEach(function(f, i){ %>
    <div class="bar-row"><span><%= f.step %></span><div class="bar"><i style="width:<%= Math.max(2, f.n / max * 100) %>%"></i></div><b><%= f.n %></b></div>
    <% }) %>
    <p class="small">Ποσοστό μετατροπής αναζήτησης → κράτησης: <strong><%= funnel[1].n ? Math.round(funnel[3].n / funnel[1].n * 100) : 0 %>%</strong></p>
  </section>
  <section class="panel">
    <h2>Πηγές κρατήσεων</h2>
    <% const tot = sources.reduce((s, x) => s + x.n, 0) || 1; sources.forEach(function(s){ %>
    <div class="bar-row"><span><%= s.s %></span><div class="bar alt"><i style="width:<%= s.n / tot * 100 %>%"></i></div><b><%= s.n %></b></div>
    <% }) %>
    <% if (unanswered) { %><p class="alert warn">🤖 <%= unanswered %> ερωτήσεις του βοηθού έμειναν αναπάντητες – <a href="/admin/chatbot">έλεγχος</a></p><% } %>
  </section>
</div>
<section class="panel">
  <h2>Πληρότητα ανά ημέρα (επόμενες 30 ημέρες)</h2>
  <% const pm = Math.max(...days.map(d => d.pct), 1); %><div class="spark"><% days.forEach(function(d){ %><i title="<%= d.d %>: <%= d.pct %>%" style="height:<%= Math.max(3, d.pct / pm * 100) %>%"><b><%= d.pct %></b></i><% }) %></div><p class="small">Κάθε στήλη αντιστοιχεί σε μία ημέρα (τιμές σε %, κλίμακα έως το μέγιστο <%= pm %>%).</p>
</section>
<section class="panel">
  <h2>Πρόσφατες κρατήσεις</h2>
  <table class="tbl"><thead><tr><th>Κωδικός</th><th>Επισκέπτης</th><th>Δωμάτιο</th><th>Άφιξη</th><th>Αναχώρηση</th><th>Σύνολο</th><th>Κατάσταση</th></tr></thead>
  <tbody><% recent.forEach(function(b){ %><tr><td><%= b.code %></td><td><%= b.first_name %> <%= b.last_name %></td><td><%= b.room %></td><td><%= b.check_in %></td><td><%= b.check_out %></td><td><%= b.total %> €</td><td><span class="st <%= b.status %>"><%= {pending:'Εκκρεμεί',confirmed:'Επιβεβαιωμένη',cancelled:'Ακυρωμένη'}[b.status] %></span></td></tr><% }) %></tbody></table>
</section>
<%- include('_bottom') %>
